  <style>
    :root {
      --primary-navy: #0b1a30;
      --primary-blue: #1e4db7;
      --accent-cyan: #00b4d8;
      --accent-coral: #ff6b35;
      --accent-green: #10b981;
      --accent-purple: #8b5cf6;
      --bg-body: #f4f6fb;
      --card-white: #ffffff;
      --text-main: #19213d;
      --text-muted: #6b7897;
      --border-soft: #e5eaf2;
      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --shadow-card: 0 4px 14px rgba(11, 26, 48, 0.05);
      --font-family: 'Plus Jakarta Sans', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: var(--font-family);
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: #0d121d;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: var(--text-main);
    }

    /* Mobile Device Frame Container */
    .app-viewport {
      width: 100%;
      max-width: 430px;
      height: 932px;
      background: var(--bg-body);
      border-radius: 40px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
      border: 8px solid #232b38;
    }

    /* Scrollable Canvas */
    .app-content {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      padding-bottom: 95px;
      scrollbar-width: none;
    }
    .app-content::-webkit-scrollbar {
      display: none;
    }

    /* Header Section with Curves */
    .header-hero {
      background: linear-gradient(175deg, var(--primary-navy) 0%, #102d62 55%, var(--primary-blue) 100%);
      padding: 24px 20px 32px 20px;
      border-radius: 0 0 32px 32px;
      color: #fff;
      position: relative;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-badge {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #00b4d8, #1e4db7);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 15px;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 10px rgba(0, 180, 216, 0.35);
      color: #fff;
    }

    .brand-title h1 {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.2px;
      line-height: 1.1;
    }

    .brand-title span {
      font-size: 11px;
      color: #9cb5db;
      font-weight: 500;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Selectors Pill */
    .select-pill {
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 20px;
      padding: 4px 8px;
      display: flex;
      align-items: center;
      gap: 4px;
      color: #fff;
      font-size: 11px;
      font-weight: 600;
    }

    .select-pill select {
      background: transparent;
      border: none;
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      outline: none;
      cursor: pointer;
    }

    .select-pill select option {
      background: var(--primary-navy);
      color: #fff;
    }

